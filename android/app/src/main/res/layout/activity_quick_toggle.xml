<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_row"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="Notification panel"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Add CaptainClip buttons to the panel you get when you swipe down from the top of the screen — next to Torch and Wi-Fi. Then you can use CaptainClip without opening the app."
            android:textColor="@color/text_secondary" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingStart="8dp"
            android:text="Buttons" />

        <include
            android:id="@+id/sendButton"
            layout="@layout/item_panel_button" />

        <include
            android:id="@+id/switchButton"
            layout="@layout/item_panel_button" />

        <TextView
            android:id="@+id/helpTitle"
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingStart="8dp" />

        <LinearLayout
            android:id="@+id/steps"
            style="@style/Card"
            android:layout_marginTop="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/done"
            style="@style/ButtonTonal"
            android:layout_marginTop="20dp"
            android:text="Done" />
    </LinearLayout>
</ScrollView>
