<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <TextView
                    style="@style/Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mac ↔ phone clipboard" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status -->
        <LinearLayout style="@style/Card" android:id="@+id/statusCard">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/statusTitle"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusDetail"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- A file waiting on the Mac -->
        <LinearLayout style="@style/Card" android:id="@+id/offerCard" android:visibility="gone">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="From your Mac" />

            <TextView
                android:id="@+id/offerName"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/offerMeta"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <TextView
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Paste it into any app that accepts files, or save a copy here. Nothing is downloaded until you do." />

            <Button
                android:id="@+id/saveButton"
                style="@style/ButtonPrimary"
                android:text="Save to Downloads" />

            <TextView
                android:id="@+id/savedText"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/openButton"
                style="@style/ButtonTonal"
                android:layout_marginTop="8dp"
                android:text="Open"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Setup (only while something is missing) -->
        <LinearLayout style="@style/Card" android:id="@+id/setupCard" android:visibility="gone">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Finish setting up" />

            <TextView
                android:id="@+id/setupTitle"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/setupHelp"
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/setupButton"
                style="@style/ButtonPrimary" />
        </LinearLayout>

        <!-- Quick actions -->
        <LinearLayout style="@style/Card" android:id="@+id/actionsCard">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Quick actions" />

            <Button
                android:id="@+id/sendClipboardButton"
                style="@style/ButtonTonal"
                android:text="Send clipboard to Mac" />

            <Button
                android:id="@+id/pauseButton"
                style="@style/ButtonTonal"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- More -->
        <LinearLayout style="@style/Card" android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView
                android:id="@+id/repairRow"
                style="@style/Row"
                android:text="Pair with a different Mac" />

            <TextView
                android:id="@+id/batteryRow"
                style="@style/Row"
                android:text="Let ClipBridge run in the background" />

            <TextView
                android:id="@+id/autoCopyRow"
                style="@style/Row"
                android:text="Automatic copy settings" />
        </LinearLayout>

        <TextView
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Tip: add the “Send to Mac” tile to Quick Settings, or use Share → Send to Mac from any app. Same Wi-Fi only · end-to-end encrypted." />
    </LinearLayout>
</ScrollView>
