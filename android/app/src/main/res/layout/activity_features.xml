<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="What CaptainClip does"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:text="Copy and paste between your Mac and this phone, both ways." />

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Try it" />

            <TextView
                style="@style/Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Copy something on your Mac, then paste it here." />

            <EditText
                android:id="@+id/tryBox"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search"
                android:gravity="top|start"
                android:hint="Paste here"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:padding="14dp" />

            <Button
                android:id="@+id/pasteButton"
                style="@style/ButtonTonal"
                android:text="Paste" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Features" />

            <LinearLayout
                android:id="@+id/features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/done"
            style="@style/ButtonPrimary"
            android:text="Got it" />
    </LinearLayout>
</ScrollView>
