<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Set up ClipBridge on your Mac"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            style="@style/Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:text="Free and open source · macOS 13 or later · Apple silicon and Intel" />

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Download" />

            <TextView
                android:id="@+id/linkText"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textIsSelectable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/openLink"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="8dp"
                    android:text="Open page" />

                <Button
                    android:id="@+id/shareLink"
                    style="@style/ButtonTonal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:text="Share link" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Steps" />

            <LinearLayout
                android:id="@+id/steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/done"
            style="@style/ButtonTonal"
            android:text="Done" />
    </LinearLayout>
</ScrollView>
